# ---------------------------------------------------------------------------
# InStyle Granite & Marble — environment variables
# Copy to `.env.local` for local dev. All are optional in dev; the site
# degrades gracefully (forms log to console, analytics disabled) when unset.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# External live-inventory (StoneProfitsWeb) — swappable per brand
NEXT_PUBLIC_INVENTORY_URL_INSTYLE="https://instylegm.stoneprofitsweb.com"
NEXT_PUBLIC_INVENTORY_URL_AVANI="https://avanimarble.stoneprofitsweb.com"

# Contact / quote shortcuts (TODO client: replace with real numbers)
NEXT_PUBLIC_PHONE="+10000000000"
NEXT_PUBLIC_WHATSAPP="+10000000000"
NEXT_PUBLIC_CONTACT_EMAIL="info@example.com"

# GA4 — analytics is only loaded after cookie consent AND when this is set
NEXT_PUBLIC_GA_ID=""

# Set to "true" once the hero video + poster exist in /public
# (/warehouse-tour.mp4 and /warehouse-poster.jpg). Left unset, the home hero
# renders a stone-toned gradient with no missing-asset requests.
NEXT_PUBLIC_HERO_MEDIA=""

# Resend (server only) — quote form email delivery. Unset in dev = log to console.
RESEND_API_KEY=""
QUOTE_RECIPIENT_EMAIL="sales@example.com"
QUOTE_FROM_EMAIL="website@example.com"
